# Custom PostgreSQL with PostGIS and pgvector
FROM postgis/postgis:15-3.4-alpine

# Install build dependencies and pgvector
RUN apk add --no-cache --virtual .build-deps \
        git \
        build-base \
        clang15 \
        llvm15 \
        postgresql-dev && \
    cd /tmp && \
    git clone --branch v0.5.1 https://github.com/pgvector/pgvector.git && \
    cd pgvector && \
    make && \
    make install && \
    cd / && \
    rm -rf /tmp/pgvector && \
    apk del .build-deps

# Verify extensions are available
RUN echo "Installed extensions:" && \
    ls -la /usr/local/share/postgresql/extension/ | grep -E "postgis|vector"
