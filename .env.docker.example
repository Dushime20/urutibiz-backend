# UrutiBiz Docker Environment Configuration
# Use this for Docker Compose deployments

# Application
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# Frontend Configuration (Update with your production URL)
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database Configuration (Using Docker service name)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=urutibiz_db
DB_USER=urutibiz_user
DB_PASSWORD=change_this_to_secure_password
DB_SSL=false

# Redis Configuration (Using Docker service name)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_to_secure_password

# JWT Configuration (Generate 32+ character random strings)
JWT_SECRET=generate_secure_random_string_here
JWT_REFRESH_SECRET=generate_another_secure_random_string_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=12
ENCRYPTION_KEY=32_character_encryption_key_here

# Python Image Service (Using Docker service name)
PYTHON_IMAGE_SERVICE_URL=http://python-service:8001

# AI & External Services (Provision real keys here)
# GEMINI_API_KEY=
# GROQ_API_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# Firebase
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Development Tools
SWAGGER_ENABLED=false
LOG_LEVEL=info
